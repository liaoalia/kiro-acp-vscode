{
  "name": "permission-reject",
  "description": "An edit tool call that asks for permission; when rejected the call fails with _meta.kiro.failureReason = denied.",
  "steps": [
    { "kind": "update", "update": { "sessionUpdate": "tool_call", "toolCallId": "call-edit", "title": "Overwrite config.json", "kind": "edit", "status": "pending", "locations": [ { "path": "{{cwd}}/config.json" } ], "content": [ { "type": "diff", "path": "{{cwd}}/config.json", "oldText": "{}", "newText": "{ \"debug\": true }\n" } ] } },
    { "kind": "permission",
      "toolCall": { "toolCallId": "call-edit", "title": "Overwrite config.json", "kind": "edit", "status": "pending", "content": [ { "type": "diff", "path": "{{cwd}}/config.json", "oldText": "{}", "newText": "{ \"debug\": true }\n" } ] },
      "options": [
        { "optionId": "accept", "name": "Allow", "kind": "allow_once" },
        { "optionId": "reject", "name": "Deny", "kind": "reject_once" }
      ],
      "allow": [
        { "kind": "client_request", "method": "fs/write_text_file", "params": { "sessionId": "{{sessionId}}", "path": "{{cwd}}/config.json", "content": "{ \"debug\": true }\n" } }
      ],
      "reject": []
    },
    { "kind": "update", "update": { "sessionUpdate": "agent_message_chunk", "messageId": "m1", "content": { "type": "text", "text": "Understood." } } },
    { "kind": "stop", "stopReason": "end_turn" }
  ]
}
