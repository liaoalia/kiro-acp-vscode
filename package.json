{
  "name": "kiro-acp",
  "displayName": "Kiro ACP Chat",
  "description": "Chat with the Kiro agent inside VS Code over the Agent Client Protocol (ACP). Spawns `kiro-cli acp` locally; the extension itself makes no network calls.",
  "version": "0.3.4",
  "publisher": "liaoalia",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onView:kiroAcp.chat",
    "onWebviewPanel:kiroAcp.chatPanel"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "kiroAcp",
          "title": "Kiro",
          "icon": "media/kiro.svg"
        }
      ]
    },
    "views": {
      "kiroAcp": [
        {
          "type": "webview",
          "id": "kiroAcp.chat",
          "name": "Kiro Chat",
          "icon": "media/kiro.svg",
          "contextualTitle": "Kiro Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "kiroAcp.newSession",
        "title": "Kiro: New Session",
        "icon": "$(add)"
      },
      {
        "command": "kiroAcp.newSessionInSidebar",
        "title": "Kiro: New Session in Sidebar",
        "icon": "$(add)"
      },
      {
        "command": "kiroAcp.openPastSession",
        "title": "Kiro: Open Past Session…",
        "icon": "$(history)"
      },
      {
        "command": "kiroAcp.cancel",
        "title": "Kiro: Cancel Current Turn",
        "icon": "$(debug-stop)"
      },
      {
        "command": "kiroAcp.restart",
        "title": "Kiro: Restart Agent Process"
      },
      {
        "command": "kiroAcp.login",
        "title": "Kiro: Log In (runs kiro-cli login)"
      },
      {
        "command": "kiroAcp.sendSelection",
        "title": "Kiro: Send Selection to Kiro Chat"
      },
      {
        "command": "kiroAcp.openPlan",
        "title": "Kiro: Open Plan"
      },
      {
        "command": "kiroAcp.showLog",
        "title": "Kiro: Show Protocol Log"
      },
      {
        "command": "kiroAcp.forgetSessionOptions",
        "title": "Kiro: Forget Remembered Session Options"
      },
      {
        "command": "kiroAcp.acceptDiff",
        "title": "Kiro: Accept Proposed Change",
        "icon": "$(check)"
      },
      {
        "command": "kiroAcp.rejectDiff",
        "title": "Kiro: Reject Proposed Change",
        "icon": "$(close)"
      },
      {
        "command": "kiroAcp.approvePlan",
        "title": "Kiro: Approve Plan",
        "icon": "$(check)"
      },
      {
        "command": "kiroAcp.rejectPlan",
        "title": "Kiro: Reject Plan",
        "icon": "$(close)"
      },
      {
        "command": "kiroAcp.focus",
        "title": "Kiro: Focus Chat"
      },
      {
        "command": "kiroAcp.openInEditor",
        "title": "Kiro: New Chat Tab",
        "icon": {
          "light": "media/kiro-color-light.svg",
          "dark": "media/kiro-color.svg"
        }
      },
      {
        "command": "kiroAcp.openPastSessionInSidebar",
        "title": "Kiro: Open Past Session in Sidebar…",
        "icon": "$(history)"
      }
    ],
    "keybindings": [
      {
        "command": "kiroAcp.sendSelection",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kiroAcp.openInEditor",
          "when": "view == kiroAcp.chat",
          "group": "navigation@0"
        },
        {
          "command": "kiroAcp.newSessionInSidebar",
          "when": "view == kiroAcp.chat",
          "group": "navigation@1"
        },
        {
          "command": "kiroAcp.openPastSessionInSidebar",
          "when": "view == kiroAcp.chat",
          "group": "navigation@2"
        },
        {
          "command": "kiroAcp.cancel",
          "when": "view == kiroAcp.chat && kiroAcp.turnActive",
          "group": "navigation@3"
        },
        {
          "command": "kiroAcp.openPlan",
          "when": "view == kiroAcp.chat",
          "group": "1_more@1"
        },
        {
          "command": "kiroAcp.restart",
          "when": "view == kiroAcp.chat",
          "group": "1_more@2"
        },
        {
          "command": "kiroAcp.showLog",
          "when": "view == kiroAcp.chat",
          "group": "1_more@3"
        }
      ],
      "editor/title": [
        {
          "command": "kiroAcp.openInEditor",
          "group": "navigation@0"
        },
        {
          "command": "kiroAcp.acceptDiff",
          "when": "resourceScheme == kiro-proposed && kiroAcp.diffPending",
          "group": "navigation@1"
        },
        {
          "command": "kiroAcp.rejectDiff",
          "when": "resourceScheme == kiro-proposed && kiroAcp.diffPending",
          "group": "navigation@2"
        },
        {
          "command": "kiroAcp.approvePlan",
          "when": "resourceScheme == kiro-plan && kiroAcp.planApprovalPending",
          "group": "navigation@1"
        },
        {
          "command": "kiroAcp.rejectPlan",
          "when": "resourceScheme == kiro-plan && kiroAcp.planApprovalPending",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "kiroAcp.sendSelection",
          "when": "editorHasSelection",
          "group": "kiro@1"
        }
      ],
      "commandPalette": [
        {
          "command": "kiroAcp.newSessionInSidebar",
          "when": "false"
        },
        {
          "command": "kiroAcp.acceptDiff",
          "when": "kiroAcp.diffPending"
        },
        {
          "command": "kiroAcp.rejectDiff",
          "when": "kiroAcp.diffPending"
        },
        {
          "command": "kiroAcp.approvePlan",
          "when": "kiroAcp.planApprovalPending"
        },
        {
          "command": "kiroAcp.rejectPlan",
          "when": "kiroAcp.planApprovalPending"
        },
        {
          "command": "kiroAcp.openPastSessionInSidebar",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Kiro ACP",
      "properties": {
        "kiroAcp.cliPath": {
          "type": "string",
          "default": "kiro-cli",
          "description": "Path to the kiro-cli executable. A bare name is resolved on PATH, then in the default install locations for the platform."
        },
        "kiroAcp.cliArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments appended after `acp`, for example [\"--agent-engine=v3\"]."
        },
        "kiroAcp.attachActiveFile": {
          "type": "boolean",
          "default": false,
          "description": "Attach the active editor file to each prompt as a resource link (shown as a removable chip). Off by default: add files explicitly with @ or the Send Selection command."
        },
        "kiroAcp.autoOpenDiffs": {
          "type": "string",
          "enum": [
            "always",
            "whenPermissionRequired",
            "never"
          ],
          "enumDescriptions": [
            "Open a diff editor for every file change the agent proposes, even when it is applied without asking.",
            "Open a diff editor only when a file change waits for your permission (default).",
            "Never open diff editors automatically; use the links in the chat."
          ],
          "default": "whenPermissionRequired",
          "description": "When to open the native diff editor for file changes proposed by the agent. In autonomous modes tool calls complete without a permission request; opening a tab for each would hide the chat."
        },
        "kiroAcp.terminal.mode": {
          "type": "string",
          "enum": [
            "shared",
            "perCommand",
            "hidden"
          ],
          "enumDescriptions": [
            "One VS Code terminal per Kiro session (default): every agent command writes its header, output and exit code into it. It is revealed once, on the session's first command.",
            "One VS Code terminal per agent command, revealed when the command starts.",
            "No VS Code terminal; command output is only shown in the chat card."
          ],
          "default": "shared",
          "description": "How terminals opened by the agent are shown. Read when each command starts, so a change applies to the next command."
        },
        "kiroAcp.terminal.outputByteLimit": {
          "type": "number",
          "default": 1048576,
          "description": "Default byte limit retained for agent-requested terminal output when the agent does not specify one."
        },
        "kiroAcp.logProtocol": {
          "type": "boolean",
          "default": false,
          "description": "Write every JSON-RPC message to the 'Kiro ACP' output channel (useful when reporting bugs)."
        },
        "kiroAcp.chatLocation": {
          "type": "string",
          "enum": [
            "editor",
            "sidebar"
          ],
          "enumDescriptions": [
            "Open the chat as a tab in the editor area (default).",
            "Open the chat in the Kiro view of the secondary side bar."
          ],
          "default": "editor",
          "description": "Where `Kiro: Focus Chat`, permission requests and `Send Selection` open the chat."
        },
        "kiroAcp.showSettingsByDefault": {
          "type": "boolean",
          "default": false,
          "description": "Show the mode / model / option pickers without pressing the settings button in the chat."
        },
        "kiroAcp.sessionPanelCollapsed": {
          "type": "boolean",
          "default": false,
          "description": "Start the chat with the session list collapsed to icons."
        },
        "kiroAcp.rememberSessionOptions": {
          "type": "boolean",
          "default": true,
          "description": "Remember the mode, model and config options you choose and apply them to every new session (only values the agent advertises are applied). `Kiro: Forget Remembered Session Options` clears them."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json",
    "compile-tests": "tsc -p tsconfig.test.json",
    "compile-e2e": "tsc -p tsconfig.e2e.json",
    "test": "npm run typecheck && npm run compile-tests && node --test \"out/test/**/*.test.js\"",
    "test:e2e": "npm run build && npm run compile-e2e && node scripts/run-e2e.mjs",
    "package": "npm run typecheck && npm run build && vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.106.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.5.0",
    "dompurify": "^3.4.17",
    "marked": "^18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/liaoalia/kiro-acp-vscode.git"
  }
}
